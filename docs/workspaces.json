{
  "catalogVersion": "0.1.0-draft",
  "status": "Proposed recipes and binding contracts; structural examples, not executable runtime configuration.",
  "documentation": "PRESENTATIONS.md",
  "placeCatalog": "presentations.json",
  "patterns": {
    "hierarchy-browser": {
      "places": [
        "browser"
      ],
      "bindings": [
        "nodes",
        "selection"
      ],
      "contract": "Preserve stable identity, expansion, and scoped selection through hierarchy updates."
    },
    "collection-detail": {
      "places": [
        "collection",
        "detail"
      ],
      "bindings": [
        "items",
        "selection",
        "record"
      ],
      "contract": "Resolve detail from the named selection scope; reconcile upstream changes and loading/empty/error states."
    },
    "tabbed-documents": {
      "places": [
        "group",
        "viewer"
      ],
      "bindings": [
        "openViews",
        "activeView",
        "resources"
      ],
      "contract": "Separate view identity from resource identity; preserve per-view state and define dirty-close and duplicate-open policy."
    },
    "contextual-tool": {
      "places": [
        "tool"
      ],
      "bindings": [
        "context"
      ],
      "contract": "Declare follow or pinned target behavior; capture asynchronous command context at submission."
    },
    "docked-workspace": {
      "places": [
        "switcher",
        "navigation",
        "work",
        "context",
        "status"
      ],
      "bindings": [
        "layoutState"
      ],
      "contract": "Relocate or collapse places without disposing their domain state; reconcile focus."
    },
    "synchronized-timeline": {
      "places": [
        "preview",
        "timeline",
        "transport",
        "meters"
      ],
      "bindings": [
        "sequence",
        "clock",
        "timeSelection"
      ],
      "contract": "Use one sequence clock with explicit time mappings; keep source playback independent."
    }
  },
  "dataRelations": {
    "contains": "Domain membership where hierarchical.",
    "references": "Non-owning resource association.",
    "selects": "Scoped entity selection.",
    "presents": "View of an entity or representation.",
    "follows": "Derived target from a named scope.",
    "pinned-to": "Stable explicit target.",
    "synchronized-with": "Shared time through declared mappings."
  },
  "connectionContract": "Connections describe event intent between place instances. Host adapters implement them; no events execute by loading this file.",
  "recipes": {
    "agentic-chat": {
      "families": [
        "workspace",
        "collection",
        "conversation"
      ],
      "coverage": "named",
      "bindings": {
        "projects": {
          "hostContract": "Project hierarchy; selected project scopes conversations."
        },
        "projectSelection": {
          "hostContract": "Selected project ID."
        },
        "conversations": {
          "hostContract": "Conversations in the selected project."
        },
        "conversationSelection": {
          "hostContract": "Selected conversation ID, scoped by project."
        },
        "conversation": {
          "hostContract": "Selected conversation record with transcript and asset associations."
        },
        "assets": {
          "hostContract": "Assets associated with the selected conversation or explicitly selected message."
        },
        "openViews": {
          "hostContract": "Persistent attachment/artifact view instances with originating conversation ID."
        },
        "activeView": {
          "hostContract": "Active asset view ID within this group."
        },
        "resources": {
          "hostContract": "Asset resolver preserving resource identity and availability."
        },
        "draft": {
          "hostContract": "Draft keyed by conversation ID; never retargeted by late navigation."
        },
        "runs": {
          "hostContract": "Runs keyed by project, conversation, and run ID; late events route by those IDs."
        },
        "layout": {
          "hostContract": "Docking and size preferences for this workspace instance."
        }
      },
      "places": {
        "areas": {
          "type": "activity-bar"
        },
        "projects": {
          "type": "resource-tree"
        },
        "conversations": {
          "type": "conversation-list"
        },
        "chat": {
          "type": "transcript"
        },
        "input": {
          "type": "composer"
        },
        "attachments": {
          "type": "attachment-list"
        },
        "assets": {
          "type": "document-group"
        },
        "viewer": {
          "type": "asset-viewer",
          "within": "assets"
        },
        "runs": {
          "type": "agent-activity"
        },
        "status": {
          "type": "status-bar"
        }
      },
      "patterns": [
        {
          "pattern": "hierarchy-browser",
          "places": {
            "browser": "projects"
