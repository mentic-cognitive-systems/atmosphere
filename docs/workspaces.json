          "id": "contextual-tool-5"
        },
        {
          "pattern": "contextual-tool",
          "places": {
            "tool": "runs"
          },
          "bindings": {
            "context": "runs"
          },
          "options": {
            "mode": "originating-conversation"
          },
          "id": "contextual-tool-6"
        },
        {
          "pattern": "docked-workspace",
          "places": {
            "switcher": "areas",
            "navigation": "projects",
            "work": "chat",
            "context": "assets",
            "status": "status"
          },
          "bindings": {
            "layoutState": "layout"
          },
          "id": "docked-workspace-7"
        }
      ],
      "connections": [
        {
          "source": "attachments",
