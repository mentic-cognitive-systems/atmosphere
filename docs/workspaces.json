          "places": {
            "tool": "attachments"
          },
          "bindings": {
            "context": "assets"
          },
          "options": {
            "mode": "Selected attachment activation requests opening; active document owns viewer."
          },
          "id": "contextual-tool-3"
        },
        {
          "pattern": "tabbed-documents",
          "places": {
            "group": "assets",
            "viewer": "viewer"
          },
          "bindings": {
            "openViews": "openViews",
            "activeView": "activeView",
            "resources": "resources"
          },
          "options": {
            "retention": "persist-across-conversation-selection",
            "precedence": "Active view owns viewer after opening; collection selection only supplies an activation candidate."
